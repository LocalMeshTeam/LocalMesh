{
  "name": "localmesh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:renderer\" \"bun run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:1420 && bun run build:electron && bun run rebuild:native && electron dist-electron/main.js",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "preview": "vite preview",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.3"
  }
}
